// Simmory Prisma Schema
// Phase 3: Family Kitchen & Recipe Management

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum KitchenRole {
  OWNER
  EDITOR
  VIEWER
  ADMIN
  MEMBER
}

enum RecipeStatus {
  DRAFT
  PROCESSING
  REVIEW_PENDING
  VERIFIED_BY_COOK
  IN_REVIEW
  VERIFIED
}

enum VideoUploadStatus {
  PENDING_UPLOAD
  UPLOADED
  FAILED
  DELETED
}

enum VideoProcessingStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshSessions    RefreshSession[]
  ownedKitchens      Kitchen[]        @relation("KitchenOwner")
  kitchenMemberships KitchenMember[]
  createdRecipes     Recipe[]         @relation("RecipeAuthor")
  uploadedVideos     CookingVideo[]   @relation("UserVideos")

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model Kitchen {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  coverImageUrl String?
  ownerId       String   @db.Uuid
  owner         User     @relation("KitchenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members KitchenMember[]
  recipes Recipe[]
  videos  CookingVideo[]

  @@index([ownerId])
  @@map("kitchens")
}

model KitchenMember {
  id        String      @id @default(uuid()) @db.Uuid
  kitchenId String      @db.Uuid
  kitchen   Kitchen     @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      KitchenRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  @@unique([kitchenId, userId])
  @@index([userId])
  @@index([kitchenId])
  @@map("kitchen_members")
}

model Recipe {
  id          String       @id @default(uuid()) @db.Uuid
  kitchenId   String       @db.Uuid
  kitchen     Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  title       String
  description String?
  cookName    String       @default("Family Cook")
  story       String?
  origin      String?
  notes       String?
  createdById String       @db.Uuid
  createdBy   User         @relation("RecipeAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  status      RecipeStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  videos      CookingVideo[]

  @@index([kitchenId])
  @@index([createdById])
  @@index([status])
  @@map("recipes")
}

model RecipeIngredient {
  id        String   @id @default(uuid()) @db.Uuid
  recipeId  String   @db.Uuid
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String
  quantity  String?
  notes     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id                  String   @id @default(uuid()) @db.Uuid
  recipeId            String   @db.Uuid
  recipe              Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  instruction         String
  position            Int      @default(0)
  duration            String?
  sensoryCue          String?
  notes               String?
  videoTimestampStart Int?
  videoTimestampEnd   Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([recipeId])
  @@map("recipe_steps")
}

model CookingVideo {
  id               String                @id @default(uuid()) @db.Uuid
  kitchenId        String                @db.Uuid
  kitchen          Kitchen               @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  recipeId         String?               @db.Uuid
  recipe           Recipe?               @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  uploadedById     String                @db.Uuid
  uploadedBy       User                  @relation("UserVideos", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String                @unique
  contentType      String
  expectedSize     Int
  actualSize       Int?
  duration         Float?
  uploadStatus     VideoUploadStatus     @default(PENDING_UPLOAD)
  processingStatus VideoProcessingStatus @default(NOT_STARTED)
  uploadExpiresAt  DateTime
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([kitchenId])
  @@index([recipeId])
  @@index([uploadedById])
  @@index([uploadStatus])
  @@map("cooking_videos")
}
