// Simmory Prisma Schema
// Phase 3: Family Kitchen & Recipe Management

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum KitchenRole {
  OWNER
  EDITOR
  VIEWER
  ADMIN
  MEMBER
}

enum RecipeStatus {
  DRAFT
  PROCESSING
  REVIEW_PENDING
  VERIFIED_BY_COOK
  IN_REVIEW
  VERIFIED
}

enum VideoUploadStatus {
  PENDING_UPLOAD
  UPLOADED
  FAILED
  DELETED
}

enum VideoProcessingStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MediaValidationStatus {
  NOT_STARTED
  QUEUED
  VALIDATING
  VALIDATED
  FAILED
}

enum JobType {
  VIDEO_VALIDATION
  AI_ANALYSIS
}

enum JobStatus {
  PENDING_DISPATCH
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum EventReviewStatus {
  UNREVIEWED
  ACCEPTED
  EDITED
  REJECTED
}

enum ClarificationStatus {
  UNANSWERED
  ANSWERED
  UNKNOWN
  NOT_APPLICABLE
}

enum ClarificationSource {
  AI_GENERATED
  HUMAN_ADDED
}

enum IngredientProvenance {
  SPOKEN_INSTRUCTION
  VISUALLY_SUGGESTED
  HUMAN_SUPPLIED
  HUMAN_CONFIRMED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshSessions    RefreshSession[]
  ownedKitchens      Kitchen[]        @relation("KitchenOwner")
  kitchenMemberships KitchenMember[]
  createdRecipes     Recipe[]         @relation("RecipeAuthor")
  reviewedRecipes    Recipe[]         @relation("RecipeReviewer")
  uploadedVideos     CookingVideo[]   @relation("UserVideos")
  reviews            CookingReview[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model Kitchen {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  coverImageUrl String?
  ownerId       String   @db.Uuid
  owner         User     @relation("KitchenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members KitchenMember[]
  recipes Recipe[]
  videos  CookingVideo[]
  processingJobs ProcessingJob[]
  reviews CookingReview[]

  @@index([ownerId])
  @@map("kitchens")
}

model KitchenMember {
  id        String      @id @default(uuid()) @db.Uuid
  kitchenId String      @db.Uuid
  kitchen   Kitchen     @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      KitchenRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  @@unique([kitchenId, userId])
  @@index([userId])
  @@index([kitchenId])
  @@map("kitchen_members")
}

model Recipe {
  id             String       @id @default(uuid()) @db.Uuid
  kitchenId      String       @db.Uuid
  kitchen        Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  cookName       String       @default("Family Cook")
  story          String?
  origin         String?
  notes          String?
  createdById    String       @db.Uuid
  createdBy      User         @relation("RecipeAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  status         RecipeStatus @default(DRAFT)
  sourceReviewId String?      @db.Uuid
  reviewedAt     DateTime?
  reviewedById   String?      @db.Uuid
  reviewedBy     User?        @relation("RecipeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cookVerified   Boolean      @default(false)
  cookVerifiedAt DateTime?
  cookVerifiedBy String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  videos      CookingVideo[]
  reviews     CookingReview[]

  @@index([kitchenId])
  @@index([createdById])
  @@index([status])
  @@map("recipes")
}

model RecipeIngredient {
  id        String   @id @default(uuid()) @db.Uuid
  recipeId  String   @db.Uuid
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String
  quantity  String?
  notes     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id                  String   @id @default(uuid()) @db.Uuid
  recipeId            String   @db.Uuid
  recipe              Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  instruction         String
  position            Int      @default(0)
  duration            String?
  sensoryCue          String?
  notes               String?
  videoTimestampStart Int?
  videoTimestampEnd   Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  evidence            RecipeEvidence[]

  @@index([recipeId])
  @@map("recipe_steps")
}

model CookingVideo {
  id               String                @id @default(uuid()) @db.Uuid
  kitchenId        String                @db.Uuid
  kitchen          Kitchen               @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  recipeId         String?               @db.Uuid
  recipe           Recipe?               @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  uploadedById     String                @db.Uuid
  uploadedBy       User                  @relation("UserVideos", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String                @unique
  contentType      String
  expectedSize     Int
  actualSize       Int?
  duration         Float?
  uploadStatus     VideoUploadStatus     @default(PENDING_UPLOAD)
  processingStatus VideoProcessingStatus @default(NOT_STARTED)
  validationStatus MediaValidationStatus @default(NOT_STARTED)
  videoCodec       String?
  audioCodec       String?
  width            Int?
  height           Int?
  fps              Float?
  validationError  String?
  uploadExpiresAt  DateTime
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  processingJobs   ProcessingJob[]
  analyses         AIAnalysis[]
  reviews          CookingReview[]
  recipeEvidences  RecipeEvidence[]

  @@index([kitchenId])
  @@index([recipeId])
  @@index([uploadedById])
  @@index([uploadStatus])
  @@index([validationStatus])
  @@map("cooking_videos")
}

model ProcessingJob {
  id             String    @id @default(uuid()) @db.Uuid
  videoId        String    @db.Uuid
  video          CookingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  kitchenId      String    @db.Uuid
  kitchen        Kitchen   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  jobType        JobType   @default(VIDEO_VALIDATION)
  status         JobStatus @default(PENDING_DISPATCH)
  stage          String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  errorCode      String?
  errorMessage   String?
  progressInfo   String?
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastHeartbeat  DateTime?
  bullMqJobId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  aiAnalyses     AIAnalysis[]

  @@index([videoId])
  @@index([kitchenId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
  @@map("processing_jobs")
}

enum SpeechStatus {
  USABLE_SPEECH
  NO_AUDIO_TRACK
  NO_USABLE_SPEECH
  LOW_CONFIDENCE
  TRANSCRIPTION_FAILED
}

enum AIAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

model AIAnalysis {
  id               String           @id @default(uuid()) @db.Uuid
  videoId          String           @db.Uuid
  video            CookingVideo     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  jobId            String?          @db.Uuid
  job              ProcessingJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  schemaVersion    String           @default("1.0.0")
  whisperModel     String           @default("small")
  visionModel      String           @default("gemma4:e4b-it-qat")
  speechStatus     SpeechStatus     @default(NO_USABLE_SPEECH)
  detectedLanguage String?
  status           AIAnalysisStatus @default(PROCESSING)
  summary          String?
  totalFrames      Int              @default(0)
  samplingStrategy String?
  coverageRatio    Float?
  sampledTimeRange Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  transcriptSegments TranscriptSegment[]
  visualObservations VisualObservation[]
  proposedEvents     ProposedCookingEvent[]
  reviews            CookingReview[]

  @@index([videoId])
  @@index([jobId])
  @@index([status])
  @@map("ai_analyses")
}

model TranscriptSegment {
  id          String     @id @default(uuid()) @db.Uuid
  analysisId  String     @db.Uuid
  analysis    AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  start       Float
  end         Float
  text        String
  language    String?
  needsReview Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([analysisId])
  @@index([position])
  @@map("transcript_segments")
}

model VisualObservation {
  id               String     @id @default(uuid()) @db.Uuid
  analysisId       String     @db.Uuid
  analysis         AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  frameId          String
  timestampSeconds Float
  visibleObjects   Json
  visibleAction    String?
  foodAppearance   String?
  uncertainDetails Json
  position         Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([analysisId])
  @@index([frameId])
  @@index([timestampSeconds])
  @@map("visual_observations")
}

model ProposedCookingEvent {
  id                  String     @id @default(uuid()) @db.Uuid
  analysisId          String     @db.Uuid
  analysis            AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  position            Int        @default(0)
  title               String
  description         String
  evidenceFrames      Json
  evidenceTranscripts Json?
  observedTimestamps  Json
  uncertainties       Json
  questionForCook     String?
  verified            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([analysisId])
  @@index([position])
  @@map("proposed_cooking_events")
}

model CookingReview {
  id             String       @id @default(uuid()) @db.Uuid
  videoId        String       @db.Uuid
  video          CookingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  analysisId     String       @db.Uuid
  analysis       AIAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kitchenId      String       @db.Uuid
  kitchen        Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  reviewerId     String       @db.Uuid
  reviewer       User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  recipeId       String?      @db.Uuid
  recipe         Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  status         ReviewStatus @default(DRAFT)
  notes          String?
  cookVerified   Boolean      @default(false)
  cookVerifiedBy String?
  cookVerifiedAt DateTime?
  version        Int          @default(1)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events         ReviewedCookingEvent[]
  clarifications CookingClarification[]
  ingredients    ReviewedIngredient[]

  @@index([videoId])
  @@index([kitchenId])
  @@index([reviewerId])
  @@index([analysisId])
  @@index([status])
  @@map("cooking_reviews")
}

model ReviewedCookingEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  reviewId              String            @db.Uuid
  review                CookingReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sourceProposedEventId String?           @db.Uuid
  position              Int               @default(0)
  title                 String
  description           String
  originalAiTitle       String?
  originalAiDescription String?
  startTimestamp        Float
  endTimestamp          Float?
  status                EventReviewStatus @default(UNREVIEWED)
  humanClarification    String?
  sensoryCue            String?
  evidenceFrames        Json              @default("[]")
  transcriptSegments    Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  clarifications        CookingClarification[]

  @@index([reviewId])
  @@index([position])
  @@index([status])
  @@map("reviewed_cooking_events")
}

model CookingClarification {
  id        String              @id @default(uuid()) @db.Uuid
  reviewId  String              @db.Uuid
  review    CookingReview       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  eventId   String?             @db.Uuid
  event     ReviewedCookingEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  question  String
  answer    String?
  status    ClarificationStatus @default(UNANSWERED)
  source    ClarificationSource @default(AI_GENERATED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([reviewId])
  @@index([eventId])
  @@index([status])
  @@map("cooking_clarifications")
}

model ReviewedIngredient {
  id                String               @id @default(uuid()) @db.Uuid
  reviewId          String               @db.Uuid
  review            CookingReview        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  name              String
  quantity          String?
  notes             String?
  position          Int                  @default(0)
  provenance        IngredientProvenance @default(HUMAN_SUPPLIED)
  isUnknownQuantity Boolean              @default(false)
  evidenceFrames    Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([reviewId])
  @@index([position])
  @@map("reviewed_ingredients")
}

model RecipeEvidence {
  id                 String       @id @default(uuid()) @db.Uuid
  recipeStepId       String       @db.Uuid
  recipeStep         RecipeStep   @relation(fields: [recipeStepId], references: [id], onDelete: Cascade)
  videoId            String       @db.Uuid
  video              CookingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  analysisId         String?      @db.Uuid
  sourceEventId      String?      @db.Uuid
  evidenceFrames     Json         @default("[]")
  transcriptSegments Json?
  startTimestamp     Float
  endTimestamp       Float?
  createdAt          DateTime     @default(now())

  @@index([recipeStepId])
  @@index([videoId])
  @@map("recipe_evidences")
}


