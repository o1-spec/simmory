# Simmory Environment Variables — Configuration Template
# Copy this file to .env and provide your secret values.

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://simmory:simmory_dev_secret@localhost:5433/simmory_dev?schema=public"

# Test Database Connection String (for isolated automated testing)
TEST_DATABASE_URL="postgresql://simmory:simmory_dev_secret@localhost:5433/simmory_test?schema=public"

# JWT Authentication Configuration
# Generate a cryptographically secure 256-bit secret using:
# openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_key_of_at_least_32_characters"
JWT_ISSUER="simmory-web"
JWT_AUDIENCE="simmory-users"

# Application Public Origin
# Used to enforce same-origin protections and prevent open redirects
APP_URL="http://localhost:3000"
