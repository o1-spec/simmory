{
  "name": "simmory-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/worker.mjs",
    "worker:start": "node dist/worker.mjs",
    "worker:dev": "npm run worker:build && node dist/worker.mjs",
