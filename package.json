    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.14",
    "gsap": "^3.15.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
