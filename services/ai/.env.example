# Simmory AI Service Configuration (services/ai)

# Network Configuration
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
SIMMORY_AI_INTERNAL_KEY=simmory_dev_internal_ai_secret_key_2026_change_in_prod

# Faster-Whisper Model Settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama Visual Understanding & Reasoning Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_REQUEST_TIMEOUT=180.0

# Frame Sampling and Resource Bounds
FRAME_SAMPLING_INTERVAL_SECONDS=10.0
MAX_FRAMES_PER_VIDEO=30
MAX_VIDEO_DURATION_SECONDS=3600.0
MAX_CONCURRENT_JOBS=1

# Local Temporary Processing Directory
AI_TEMP_DIR=
